# Copy to .streamlit/secrets.toml for local dashboard runs, or paste into the
# Streamlit Community Cloud app's Secrets settings. Never commit the real file.

# Hosted Postgres, pooled connection string (same database the pipeline writes to).
DATABASE_URL = "postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/discovery?sslmode=require"

# Optional: fine-grained GitHub token (actions:write only) for the "Run pipeline now" button.
# GITHUB_TOKEN = ""
# GITHUB_REPOSITORY = "buildwithniharika/google-photos-discovery-engine"

# Google service account for the Sheets export (Phase 8).
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
token_uri = "https://oauth2.googleapis.com/token"
