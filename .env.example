# Copy to .env for local runs. Never commit the real .env.

# Anthropic API key (https://console.anthropic.com/settings/keys). Needed by classify / extract /
# cluster / score and `eval --llm`. Set a monthly spend limit in the Console as a backstop.
ANTHROPIC_API_KEY=

# Only if llm.provider is switched back to groq in config/settings.yaml.
GROQ_API_KEY=

# Database. Leave empty to use local SQLite at data/discovery.db.
# Hosted Postgres (Neon / Supabase): use the *pooled* connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/discovery?sslmode=require
DATABASE_URL=

# Google service account for the Sheets export. Use a file path or the raw JSON.
GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Existing spreadsheet to update. Leave empty and the export creates a new sheet.
SHEETS_SPREADSHEET_ID=

# Salt used to hash author names at ingestion; required by `discovery ingest`.
# Any long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Keep it stable: changing it changes every author hash.
AUTHOR_HASH_SALT=
