# Copy to .env for local runs. Never commit the real .env.

# Groq API key (https://console.groq.com/keys). Needed by classify / extract / cluster / score.
GROQ_API_KEY=

# Database. Leave empty to use local SQLite at data/discovery.db.
# Hosted Postgres (Neon / Supabase): use the *pooled* connection string, e.g.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/discovery?sslmode=require
DATABASE_URL=

# Path to the Google service account JSON (Sheet read if not public, Sheets export in Phase 8).
GOOGLE_SERVICE_ACCOUNT_FILE=

# Salt used to hash author names at ingestion; required by `discovery ingest`.
# Any long random string, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# Keep it stable: changing it changes every author hash.
AUTHOR_HASH_SALT=
